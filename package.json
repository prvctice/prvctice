{
  "name": "prvctice",
  "version": "2.0.0",
  "private": true,
  "overrides": {
    "tmp": "0.2.5"
  },
  "main": "main.js",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "chat",
    "electron",
    "vue",
    "openai",
    "anthropic",
    "gemini",
    "research",
    "notes"
  ],
  "author": "Tim Moore",
  "license": "Apache-2.0",
  "description": "AI-driven research and productivity tool with multi-provider chat and notes. Runs as a web app or Electron desktop app, and includes an MCP server.",
  "repository": {
    "type": "git",
    "url": "https://github.com/prvctice/prvctice.git"
  },
  "bugs": {
    "url": "https://github.com/prvctice/prvctice/issues"
  },
  "homepage": "https://github.com/prvctice/prvctice#readme",
  "files": [
    "src/**/*",
    "public/**/*",
    "dist/**/*"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@google/genai": "^1.25.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@motionone/dom": "^10.18.0",
    "@motionone/vue": "^10.16.4",
    "@openrouter/sdk": "^0.3.14",
    "@tiptap/extension-bubble-menu": "^3.17.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-task-item": "^3.14.0",
    "@tiptap/extension-task-list": "^3.14.0",
    "@tiptap/extension-underline": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/vue-3": "^3.14.0",
    "axios": "^1.7.9",
    "bindings": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dompurify": "^3.3.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.6.2",
    "es-module-shims": "^1.8.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "file-type": "^18.0.0",
    "googleapis": "^164.0.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.1.0",
    "ical.js": "^2.2.1",
    "iconify-icon": "^2.3.0",
    "ipaddr.js": "^2.3.0",
    "jspdf": "^4.0.0",
    "marked": "^12.0.2",
    "minisearch": "^7.2.0",
    "modern-gif": "^2.0.4",
    "multer": "^1.4.5-lts.1",
    "node-addon-api": "^6.1.0",
    "node-cache": "^5.1.2",
    "pdfjs-dist": "^5.4.530",
    "pinia": "^3.0.3",
    "prom-client": "^15.1.2",
    "qs": "^6.13.1",
    "quick-lru": "^5.1.1",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.10.2",
    "three": "^0.180.0",
    "tokenx": "^1.3.0",
    "virtua": "^0.48.5",
    "vue": "^3.5.22",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.3.0",
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-fuses": "^7.2.0",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.0.1",
    "@electron/rebuild": "^4.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/node-fetch": "^2.6.13",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "c8": "^10.1.2",
    "concurrently": "^8.2.2",
    "electron": "^39.2.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.29.0",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.20.0",
    "node-gyp": "^9.4.1",
    "playwright": "^1.57.0",
    "png-to-ico": "^2.1.8",
    "postcss-html": "^1.8.1",
    "postcss-reporter": "^7.1.0",
    "prettier": "^3.3.2",
    "sharp": "^0.32.3",
    "stylelint": "^16.23.0",
    "stylelint-config-standard": "^39.0.1",
    "terser": "^5.31.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.3",
    "vite": "^7.1.10",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.2"
  },
  "build": {
    "appId": "com.electron.prvctice",
    "productName": "Prvctice",
    "files": [
      "src/**/*",
      "public/**/*",
      "dist/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": "electron/Info.plist"
    }
  },
  "scripts": {
    "test": "node --import tsx --test",
    "test:coverage": "c8 node --test",
    "test:coverage:report": "c8 report --reporter=html",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:serve": "concurrently \"npx tsx src/server.js\" \"vite preview\"",
    "serve": "concurrently \"npx tsx src/server.js\" \"vite preview\"",
    "build": "npm run web:build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "ensure:dist": "node scripts/ensure-dist.js",
    "check:dist": "node scripts/check-dist.js",
    "check:dist:defaults": "node scripts/check-dist-defaults.js",
    "config:check": "node scripts/config-check.js",
    "config:migrate": "node scripts/config-migrate.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "desktop:dev": "npm run ensure:dist && electron-forge start",
    "predesktop:package": "ELECTRON_BUILD=true npm run web:build && npm run electron:build",
    "desktop:package": "electron-forge package",
    "predesktop:make": "ELECTRON_BUILD=true npm run web:build && npm run electron:build",
    "desktop:make": "electron-forge make",
    "native:build": "npm_config_runtime=electron npm_config_target=$(node -p \"require('electron/package.json').version\") npm_config_arch=$(node -p \"process.arch\") npm_config_disturl=https://electronjs.org/headers node-gyp rebuild",
    "lint": "eslint . --ext .js,.ts && markdownlint-cli2",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:css": "stylelint \"public/**/*.css\" \"web/**/*.css\"",
    "format": "prettier --write .",
    "contract:validate": "npx tsx scripts/validate-contract.ts",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:vue": "vue-tsc --noEmit",
    "prepare": "husky install",
    "postinstall": "node scripts/postinstall-sqlite.js",
    "desktop:rebuild": "node scripts/rebuild-native-modules.js"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
