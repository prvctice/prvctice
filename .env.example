# Copy this file to `.env` and fill in values.
# Only set what you need; unset/empty values disable those features.

# --- Core ---
ANTHROPIC_API_KEY=
SESSION_SECRET=change-me-in-production

# --- OpenRouter (optional) ---
OPENROUTER_API_KEY=

# --- YouTube (optional) ---
YOUTUBE_API_KEY=

# --- TMDB (optional; free key for film search and moodboards) ---
TMDB_API_KEY=


# --- Apple Notarization (optional; for packaging) ---
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Example: Developer ID Application: Your Company (TEAMID)
APPLE_SIGN_IDENTITY=

# --- Redis session store (optional; recommended for production) ---
# Use either REDIS_URL or host/port/password triplet
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- App behavior (optional) ---
MAX_CHAT_HISTORY=50
TOOL_CONCURRENCY=3
TOOL_TIMEOUT_MS=60000
DEBUG_MCP=0

# --- Model routing (optional) ---
# Enable model-first routing (routes requests based on model capabilities)
MODEL_FIRST_ROUTER=false
# Dry-run mode for testing router without actual routing
MODEL_ROUTER_DRY_RUN=false
# TTL in minutes for recent image context
RECENT_IMAGE_TTL_MIN=20
# --- Production deployment (optional) ---
# API URL for the Prvctice backend
PRVCTICE_API_URL=
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=

# --- Google (optional; used by Electron speech recognition) ---
GOOGLE_API_KEY=
# OAuth credentials for Google speech services in desktop app
GOOGLE_DEFAULT_CLIENT_ID=
GOOGLE_DEFAULT_CLIENT_SECRET=

# --- Electron / Updates (optional) ---
# Auto-update feed; leave empty for default behavior or local dev
AUTO_UPDATE_BASE_URL=
